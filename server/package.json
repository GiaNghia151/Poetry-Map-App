{
  "name": "poetry-map-app-server",
  "version": "1.0.0",
  "description": "Server for the Poetry Map application, allowing users to add poems to specific destinations and manage their collections.",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node --transpile-only src/server.ts",
    "dev": "nodemon --exec ts-node --transpile-only src/server.ts",
    "build": "tsc"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.10.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^14.14.31",
    "nodemon": "^2.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}